# Generated or disposable
# Claude Code: .claude/settings.json is committed (hooks, deny rules); worktrees and per-user settings are not
.claude/worktrees/
.claude/settings.local.json
_to_delete*/
_scratch/
__pycache__/
*.pyc
*.log
# run evidence (PC logs) is committed: proxy/runs/<run>/
!proxy/runs/**/*.log
!harness/runs/**/*.log
!viewer/runs/**/*.log
*.dmp
*.bak
*.orig

# Game-derived extracts never go in the repo (private or public); the index records ids, paths and hashes instead.
/extract/

# Build output
/build/
/out/

# Binaries and crash dumps are built or downloaded, never committed (proxy/README.md "DXVK"; tests/test_repo_rules.py)
*.dll
*.exe
*.pdb
*.dmp
