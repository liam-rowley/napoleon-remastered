{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(//c/Program Files (x86)/Steam/steamapps/common/Napoleon Total War/**)",
      "Edit(~/repos/empire-remastered/**)",
      "Edit(/core/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/claude_hook.py\""
          }
        ]
      }
    ]
  }
}
