{
 "note": "UI function of each UI-first asset (J7). Rules are tried in order; the first whose path glob (fnmatch on the lower-case path with / separators; * crosses folders), optional exts ('' = none) and optional max_side (largest of w, h) match gives the role. A path no rule matches is 'unclassified'. Roles are UI functions, never remaster methods (those are upscale_method). Read by discovery/core/assets.py.",
 "rules": [
  {"role": "font", "paths": ["*"], "exts": [".cuf", ".fc"]},
  {"role": "campaign_minimap", "paths": ["campaign_maps/*/stratradar*"]},
  {"role": "campaign_map_lookup", "paths": ["campaign_maps/*_lookup.*"]},
  {"role": "campaign_map_art", "paths": ["campaign_maps/*_map.*"]},
  {"role": "icon_sheet", "paths": ["ui/cinematicicons*"]},
  {"role": "cursor", "paths": ["*"], "exts": [".cur", ".ani"]},
  {"role": "cursor", "paths": ["ui/cursors/*"]},
  {"role": "ui_script", "paths": ["*"], "exts": [".luac", ".lua"]},
  {"role": "ui_db", "paths": ["*"], "exts": [".db"]},
  {"role": "template", "paths": ["ui/templates/*"], "exts": ["", ".templates", ".twui", ".images"]},
  {"role": "layout", "paths": ["ui/*"], "exts": [""]},
  {"role": "editor_art", "paths": ["ui/warscapetwin/*"]},
  {"role": "flag", "paths": ["ui/flags/*"]},
  {"role": "unit_card", "paths": ["ui/units/icons/*"]},
  {"role": "unit_info_picture", "paths": ["ui/units/info/*"]},
  {"role": "portrait", "paths": ["ui/portraits/*"]},
  {"role": "building_icon", "paths": ["ui/buildings/icons/*"]},
  {"role": "building_info_picture", "paths": ["ui/buildings/info/*"]},
  {"role": "event_picture", "paths": ["ui/eventpics/*"], "exts": [".tga", ".dds", ".png", ".jpg"]},
  {"role": "event_icon", "paths": ["ui/eventicons/*"]},
  {"role": "achievement_icon", "paths": ["ui/achievements/*"]},
  {"role": "technology_icon", "paths": ["ui/campaign ui/technologies/*"]},
  {"role": "map_pip", "paths": ["ui/campaign ui/pips/*"]},
  {"role": "loading_screen", "paths": ["ui/loading_screen_pictures/*", "ui/frontend ui/loadingscreen/*"]},
  {"role": "battle_picture", "paths": ["ui/frontend ui/battles/*", "battleterrain/presets/*/screenshot*"]},
  {"role": "button_state", "paths": ["ui/battle ui/buttons/*"]},
  {"role": "button_state", "paths": ["ui/*skins/*button*", "ui/*skins/*checkbox*", "ui/*skins/*dropdown*", "ui/*skins/*slider*",
                                     "ui/*skins/*tab_*", "ui/*skins/*_down.*", "ui/*skins/*_down_*", "ui/*skins/*_roll.*",
                                     "ui/*skins/*_selected*", "ui/*skins/*_unselected*", "ui/*skins/*_inactive*", "ui/*skins/*_depress*",
                                     "ui/*skins/*_hover*", "ui/*skins/*_active*", "ui/*skins/*_off.*", "ui/*skins/*_up.*"]},
  {"role": "panel_frame", "paths": ["ui/*skins/*frame*", "ui/*skins/*pane*", "ui/*skins/*corner*", "ui/*skins/*border*",
                                    "ui/*skins/*fill*", "ui/*skins/*paper*", "ui/*skins/*_bg*", "ui/*skins/*background*",
                                    "ui/*skins/*edge*", "ui/*skins/*line*", "ui/*skins/*bar*", "ui/*skins/*_left*",
                                    "ui/*skins/*_right*", "ui/*skins/*_center*", "ui/*skins/*_top*", "ui/*skins/*_bottom*",
                                    "ui/*skins/*/top.*", "ui/*skins/*/bottom.*", "ui/*skins/*/left.*", "ui/*skins/*/right.*",
                                    "ui/*skins/* tl.*", "ui/*skins/* tr.*", "ui/*skins/* bl.*", "ui/*skins/* br.*", "ui/*skins/*_tl.*",
                                    "ui/*skins/*_tr.*", "ui/*skins/*_bl.*", "ui/*skins/*_br.*"]},
  {"role": "icon", "paths": ["ui/*skins/*"], "max_side": 64},
  {"role": "ui_art", "paths": ["ui/*skins/*"]}
 ]
}
