/* ---- 20_panel.rcss ---- */
/* Panel plate, header band (faction fill, double rule), section head, stat row, divider. LANGUAGE.md sections 4 and 5. */
.panel {
	background-color: #f1f3f5;
	color: #1a2230;
	border: 1dp #2a3547;
	border-radius: 0;
	box-shadow: 0 0 0 4dp #f1f3f5, 0 0 0 5dp #2a3547, 0 6dp 0 5dp #959ca6;
}
.panel-head {
	background-color: var(--fac);
	color: var(--on-fac);
	padding: 8dp 14dp;
	border-bottom: 1dp var(--on-fac);
	box-shadow: inset 0 -1dp 0 0 var(--fac), inset 0 -2dp 0 0 var(--on-fac);
}
.panel-body {
	padding: 14dp;
}
.section-head {
	font-family: "Libre Baskerville";
	font-weight: 700;
	font-size: 17dp;
	line-height: 22dp;
	background-color: #f1f3f5;
	padding-bottom: 4dp;
	border-bottom: 1dp #2a3547;
	box-shadow: inset 0 -1dp 0 0 #f1f3f5, inset 0 -2dp 0 0 #2a3547;
	margin-bottom: 12dp;
}
.divider {
	height: 3dp;
	border-top: 1dp #2a3547;
	border-bottom: 1dp #2a3547;
}
.stat-row {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	height: 30dp;
	padding-bottom: 4dp;
}
.stat-label {
	font-family: "Public Sans";
	font-weight: 600;
	font-size: 14dp;
	line-height: 18dp;
}
.stat-gap {
	flex: 1 1 0;
	height: 1dp;
	margin: 0 8dp 4dp 8dp;
	decorator: repeating-linear-gradient(90deg, #9aa5b3 0, #9aa5b3 1dp, transparent 1dp, transparent 3dp);
}
.stat-gap.is-ruled {
	background-color: #9aa5b3;
	decorator: none;
}
.stat-val {
	font-family: "Libre Baskerville";
	font-weight: 400;
	font-size: 14dp;
	line-height: 20dp;
	text-align: right;
}
/* ---- 30_controls.rcss ---- */
/* Button, tab and tab group, checkbox, round order button, ability slot, manoeuvre button. Frame recipe: 1 dp ink border plus two inset rings
   (the gap ring takes the control's fill, held in --fill so hover, pressed, selected and the focus ring never restate the frame).
   Every pseudo-class rule has a twin class (.is-hover, .is-pressed, .is-selected, .is-disabled, .is-focus) so the board can show all
   states at once and a screen can drive state from its model. LANGUAGE.md sections 4 and 7. */
.btn, .tab, .check, .order-btn, .ability-slot, .manoeuvre-btn {
	border: 1dp #2a3547;
	border-radius: 0;
	--fill: #e1e6eb;
	background-color: var(--fill);
	box-shadow: inset 0 0 0 2dp var(--fill), inset 0 0 0 3dp #2a3547;
	color: #1a2230;
	tab-index: auto;
	cursor: pointer;
}
.btn:hover, .tab:hover, .check:hover, .order-btn:hover, .ability-slot:hover, .manoeuvre-btn:hover,
.btn.is-hover, .tab.is-hover, .check.is-hover, .order-btn.is-hover, .ability-slot.is-hover, .manoeuvre-btn.is-hover {
	--fill: #d5dbe1;
}
.btn:active, .tab:active, .check:active, .order-btn:active, .ability-slot:active, .manoeuvre-btn:active,
.btn.is-pressed, .tab.is-pressed, .check.is-pressed, .order-btn.is-pressed, .ability-slot.is-pressed, .manoeuvre-btn.is-pressed {
	--fill: #ccd2d9;
}
.btn:active, .btn.is-pressed, .order-btn:active, .order-btn.is-pressed, .ability-slot:active, .ability-slot.is-pressed,
.manoeuvre-btn:active, .manoeuvre-btn.is-pressed {
	transform: translateY(1dp);
}
.btn:focus-visible, .tab:focus-visible, .check:focus-visible, .order-btn:focus-visible, .ability-slot:focus-visible, .manoeuvre-btn:focus-visible,
.btn.is-focus, .tab.is-focus, .check.is-focus, .order-btn.is-focus, .ability-slot.is-focus, .manoeuvre-btn.is-focus {
	box-shadow: 0 0 0 3dp #0b5fd0, inset 0 0 0 2dp var(--fill), inset 0 0 0 3dp #2a3547;
}
.btn.is-disabled, .tab.is-disabled, .check.is-disabled, .order-btn.is-disabled, .ability-slot.is-disabled, .manoeuvre-btn.is-disabled {
	opacity: 0.5;
	pointer-events: none;
}

/* Button: 36 dp, label style; primary and toggled take the faction fill */
.btn {
	display: inline-block;
	height: 36dp;
	padding: 8dp 16dp;
	font-family: "Public Sans";
	font-weight: 600;
	font-size: 14dp;
	line-height: 18dp;
	text-align: center;
}
.btn-primary, .btn.is-selected {
	--fill: var(--fac);
	color: var(--on-fac);
}
.btn-primary:hover, .btn-primary.is-hover, .btn.is-selected:hover, .btn.is-selected.is-hover {
	--fill: var(--fac-hover);
}
.btn-primary:active, .btn-primary.is-pressed, .btn.is-selected:active, .btn.is-selected.is-pressed {
	--fill: var(--fac-pressed);
}

/* Tab: 36 dp, no bottom border, sits on the tab group's rule; selected takes the faction fill */
.tab-group {
	display: flex;
	flex-direction: row;
	border-bottom: 1dp #2a3547;
}
.tab {
	display: inline-block;
	height: 36dp;
	padding: 8dp 18dp;
	margin-right: 4dp;
	border-bottom-width: 0;
	color: #4a586b;
	font-family: "Public Sans";
	font-weight: 600;
	font-size: 14dp;
	line-height: 18dp;
	text-align: center;
}
.tab.is-selected {
	--fill: var(--fac);
	color: var(--on-fac);
}
.tab.is-selected:hover, .tab.is-selected.is-hover {
	--fill: var(--fac-hover);
}
.tab.is-selected:active, .tab.is-selected.is-pressed {
	--fill: var(--fac-pressed);
}
.tab:hover, .tab.is-hover, .tab:active, .tab.is-pressed {
	color: #1a2230;
}
.tab.is-selected:hover, .tab.is-selected.is-hover, .tab.is-selected:active, .tab.is-selected.is-pressed {
	color: var(--on-fac);
}

/* Checkbox: 22 dp frame; checked draws the faction-filled mark */
.check {
	display: inline-block;
	width: 22dp;
	height: 22dp;
	--fill: #f1f3f5;
}
.check-mark {
	display: none;
	width: 10dp;
	height: 10dp;
	margin: 5dp;
	background-color: var(--fac);
	border: 1dp #2a3547;
}
.check.is-checked .check-mark {
	display: block;
}

/* Round order button (56 dp), ability slot (56 dp), manoeuvre button (44 dp): frame and art slot, the art comes from the screen */
.order-btn {
	display: inline-block;
	width: 56dp;
	height: 56dp;
	border-radius: 28dp;
}
.ability-slot {
	display: inline-block;
	width: 56dp;
	height: 56dp;
}
.manoeuvre-btn {
	display: inline-block;
	width: 44dp;
	height: 44dp;
}
.slot-art {
	width: 100%;
	height: 100%;
}
.order-btn.is-selected, .ability-slot.is-selected, .manoeuvre-btn.is-selected {
	box-shadow: 0 0 0 3dp var(--fac), 0 0 0 4dp #2a3547, inset 0 0 0 2dp var(--fill), inset 0 0 0 3dp #2a3547;
}
/* ---- 40_content.rcss ---- */
/* List row, tooltip, progress bars, card frame, number badge, icon, flag and frame slots, scrollbars. LANGUAGE.md sections 4 to 7. */

/* List row: 30 dp, 1 dp rule below, even rows hatched (.list-hatch parent or .is-hatch on the row); faction fill when selected */
.list-row {
	height: 30dp;
	padding: 0 8dp;
	border-bottom: 1dp #9aa5b3;
	--fill: #f1f3f5;
	background-color: var(--fill);
	color: #1a2230;
	font-family: "Public Sans";
	font-weight: 400;
	font-size: 15dp;
	line-height: 29dp;
	tab-index: auto;
	cursor: pointer;
}
.list-hatch .list-row:nth-child(even), .list-row.is-hatch {
	decorator: repeating-linear-gradient(135deg, #1a223014 0, #1a223014 1dp, transparent 1dp, transparent 4dp);
}
.list-row:hover, .list-row.is-hover {
	--fill: #d5dbe1;
}
.list-row:active, .list-row.is-pressed {
	--fill: #ccd2d9;
}
.list-row.is-selected {
	--fill: var(--fac);
	color: var(--on-fac);
	decorator: none;
}
.list-row.is-selected:hover, .list-row.is-selected.is-hover {
	--fill: var(--fac-hover);
}
.list-row.is-selected:active, .list-row.is-selected.is-pressed {
	--fill: var(--fac-pressed);
}
.list-row:focus-visible, .list-row.is-focus {
	box-shadow: inset 0 0 0 3dp #0b5fd0;
}
.list-row.is-disabled {
	opacity: 0.5;
	pointer-events: none;
}

/* Tooltip: frame on panel_raised, max 340 dp; hidden is display none (never opacity 0), shown by .is-shown. The panel host places it. */
.tooltip {
	display: none;
	max-width: 340dp;
	padding: 12dp 14dp;
	border: 1dp #2a3547;
	border-radius: 0;
	background-color: #e1e6eb;
	box-shadow: inset 0 0 0 2dp #e1e6eb, inset 0 0 0 3dp #2a3547, 0 4dp 0 0 #959ca6;
	color: #1a2230;
	font-family: "Public Sans";
	font-weight: 400;
	font-size: 14dp;
	line-height: 19dp;
}
.tooltip.is-shown {
	display: inline-block;
}
.tooltip-title {
	font-family: "Libre Baskerville";
	font-weight: 700;
	font-size: 15dp;
	line-height: 20dp;
}

/* Progress bar: 12 dp track, hatched fill in the faction colour (semantic bars take positive, negative, warning) */
.bar {
	height: 12dp;
	background-color: #f1f3f5;
	border: 1dp #2a3547;
}
.bar-fill {
	height: 100%;
	background-color: var(--fac);
	decorator: repeating-linear-gradient(135deg, #ffffff47 0, #ffffff47 1dp, transparent 1dp, transparent 4dp);
}
.bar-fill.is-positive, .seg-cell.is-on.is-positive { background-color: #1f6a3a; }
.bar-fill.is-negative, .seg-cell.is-on.is-negative { background-color: #a3231a; }
.bar-fill.is-warning, .seg-cell.is-on.is-warning { background-color: #8a5a00; }
.seg {
	display: flex;
	flex-direction: row;
}
.seg-cell {
	width: 12dp;
	height: 10dp;
	margin-right: 4dp;
	border: 1dp #2a3547;
	background-color: #f1f3f5;
}
.seg-cell.is-on {
	background-color: var(--fac);
}

/* Card frame: frame recipe, faction edge on top (.card-top is the first child), content in .card-body */
.card {
	border: 1dp #2a3547;
	border-radius: 0;
	background-color: #f1f3f5;
	box-shadow: inset 0 0 0 2dp #f1f3f5, inset 0 0 0 3dp #2a3547;
}
.card-top {
	height: 4dp;
	background-color: var(--fac);
	border-bottom: 1dp #2a3547;
}
.card-body {
	padding: 12dp;
}

/* Number badge: 22 dp high, faction fill; a negative count is negative with white text */
.badge {
	display: inline-block;
	height: 22dp;
	min-width: 22dp;
	padding: 0 6dp;
	border: 1dp #2a3547;
	background-color: var(--fac);
	color: var(--on-fac);
	font-family: "Public Sans";
	font-weight: 600;
	font-size: 14dp;
	line-height: 20dp;
	text-align: center;
}
.badge.is-negative {
	background-color: #a3231a;
	color: #ffffff;
}

/* Icon: a tinted glyph slot at 16, 20, 24 and 28 dp (the art is a near-black PNG, image-color tints it) */
.icon {
	display: inline-block;
	image-color: #1a2230;
}
.icon-s { width: 16dp; height: 16dp; }
.icon-m { width: 20dp; height: 20dp; }
.icon-l { width: 24dp; height: 24dp; }
.icon-xl { width: 28dp; height: 28dp; }
.icon-on-fac { image-color: var(--on-fac); }
.icon-dim { image-color: #4a586b; }
.icon.is-disabled { opacity: 0.5; }

/* Slots: the flag frame and a plain frame for engine render targets (the 3D unit preview); art or the engine fills them */
.flag-slot {
	display: inline-block;
	width: 48dp;
	height: 32dp;
	border: 1dp #2a3547;
	background-color: #e1e6eb;
}
.frame-slot {
	border: 1dp #2a3547;
	background-color: #e1e6eb;
	box-shadow: inset 0 0 0 2dp #e1e6eb, inset 0 0 0 3dp #2a3547;
	decorator: repeating-linear-gradient(135deg, #1a223014 0, #1a223014 1dp, transparent 1dp, transparent 4dp);
}

/* Scrollbars */
scrollbarvertical, scrollbarhorizontal {
	background-color: #e1e6eb;
}
scrollbarvertical {
	width: 12dp;
	border-left: 1dp #9aa5b3;
}
scrollbarhorizontal {
	height: 12dp;
	border-top: 1dp #9aa5b3;
}
scrollbarvertical slidertrack, scrollbarhorizontal slidertrack {
	background-color: transparent;
}
scrollbarvertical sliderbar {
	width: 12dp;
	min-height: 24dp;
}
scrollbarhorizontal sliderbar {
	height: 12dp;
	min-width: 24dp;
}
scrollbarvertical sliderbar, scrollbarhorizontal sliderbar {
	background-color: #4a586b;
	border: 1dp #e1e6eb;
}
scrollbarvertical sliderbar:hover, scrollbarhorizontal sliderbar:hover {
	background-color: #1a2230;
}
scrollbarvertical sliderbar:active, scrollbarhorizontal sliderbar:active {
	background-color: #2a3547;
}
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc, scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc {
	width: 0;
	height: 0;
}
