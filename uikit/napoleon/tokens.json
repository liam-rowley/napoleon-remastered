{
  "_doc": "J34: the single source of every colour, length, type style and faction rule of the Napoleon design language (D43, design/napoleon/LANGUAGE.md). Screens and the library are written as RCSS with $name references; build.py expands them. Colours are hex (8 digits = with alpha), lengths are integers in dp, type styles are family, weight, size, line. Derived colours and the faction record are computed (tokens.py), never typed twice.",
  "color": {
    "bg_deep": "#c9d0d8",
    "panel": "#f1f3f5",
    "panel_raised": "#e1e6eb",
    "line": "#9aa5b3",
    "control_border": "#2a3547",
    "text": "#1a2230",
    "text_dim": "#4a586b",
    "accent_fill": "#1f4e8c",
    "accent_text": "#1a478a",
    "positive": "#1f6a3a",
    "negative": "#a3231a",
    "warning": "#8a5a00",
    "focus_ring": "#0b5fd0",
    "on_faction_dark": "#0b0f16",
    "on_faction_light": "#ffffff"
  },
  "derived": {
    "hover": {"mix": ["panel_raised", "text_dim", 0.08]},
    "pressed": {"mix": ["panel_raised", "text_dim", 0.14]},
    "hatch_row": {"alpha": ["text", 0.08]},
    "hatch_bar": {"alpha": ["on_faction_light", 0.28]},
    "shadow": {"mix": ["bg_deep", "text", 0.3]},
    "row_hatched": {"mix": ["panel", "text", 0.08]}
  },
  "faction": {
    "_doc": "Four values per screen from the owning faction's primary colour (faction_tokens in tokens.py). They reach RCSS as custom properties on the document body: $fac -> var(--fac), $on_fac -> var(--on-fac), $fac_hover -> var(--fac-hover), $fac_pressed -> var(--fac-pressed).",
    "vars": {"fac": "--fac", "on_fac": "--on-fac", "fac_hover": "--fac-hover", "fac_pressed": "--fac-pressed"},
    "default_fill": "accent_fill",
    "default_on": "on_faction_light",
    "dark_on": "on_faction_dark",
    "light_on": "on_faction_light",
    "hover_step": 0.12,
    "pressed_step": 0.24,
    "min_ratio": 4.5,
    "adjust_step": 0.02
  },
  "faction_synthetic": {
    "_doc": "The only faction colours committed: France and Britain (LANGUAGE.md section 2) and made-up colours that exercise the rule. The 77 real rows are read from the git-ignored extract and only counted.",
    "france": [9, 79, 150],
    "britain": [222, 0, 0],
    "synth_light": [250, 247, 205],
    "synth_dark": [12, 22, 48],
    "synth_worst": [240, 0, 70]
  },
  "type": {
