    "section_head": {"family": "Libre Baskerville", "weight": 700, "size": 17, "line": 22},
    "body": {"family": "Public Sans", "weight": 400, "size": 15, "line": 21},
    "label": {"family": "Public Sans", "weight": 600, "size": 14, "line": 18},
