/* Panel plate, header band (faction fill, double rule), section head, stat row, divider. LANGUAGE.md sections 4 and 5. */
.panel {
	background-color: $panel;
	color: $text;
	border: $hairline $control_border;
	border-radius: $radius;
	box-shadow: 0 0 0 $ring_inner $panel, 0 0 0 $ring_outer $control_border, 0 $plate_shadow_y 0 $ring_outer $shadow;
}
.panel-head {
	background-color: $fac;
	color: $on_fac;
	padding: $gap $panel_padding;
	border-bottom: $hairline $on_fac;
	box-shadow: inset 0 -$hairline 0 0 $fac, inset 0 -$ring_gap 0 0 $on_fac;
}
.panel-body {
	padding: $panel_padding;
}
.section-head {
	font-family: $type.section_head.family;
	font-weight: $type.section_head.weight;
	font-size: $type.section_head.size;
	line-height: $type.section_head.line;
	background-color: $panel;
	padding-bottom: $gap_s;
	border-bottom: $hairline $control_border;
	box-shadow: inset 0 -$hairline 0 0 $panel, inset 0 -$ring_gap 0 0 $control_border;
	margin-bottom: $section_gap;
}
.divider {
	height: $inset_inner;
	border-top: $hairline $control_border;
	border-bottom: $hairline $control_border;
}
.stat-row {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	height: $row;
	padding-bottom: $gap_s;
}
.stat-label {
	font-family: $type.label.family;
	font-weight: $type.label.weight;
	font-size: $type.label.size;
	line-height: $type.label.line;
}
.stat-gap {
	flex: 1 1 0;
	height: $hairline;
	margin: 0 $gap $gap_s $gap;
	decorator: repeating-linear-gradient(90deg, $line 0, $line $hairline, transparent $hairline, transparent $inset_inner);
}
.stat-gap.is-ruled {
	background-color: $line;
	decorator: none;
}
.stat-val {
	font-family: $type.numeral.family;
	font-weight: $type.numeral.weight;
	font-size: $type.numeral.size;
	line-height: $type.numeral.line;
	text-align: right;
}
