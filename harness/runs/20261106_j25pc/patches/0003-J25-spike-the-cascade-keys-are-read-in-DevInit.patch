From 0d350a4ba6b6aebdf46040011c9a62bb937108e8 Mon Sep 17 00:00:00 2001
From: Liam Rowley <liamsrowley@gmail.com>
Date: Fri, 6 Nov 2026 01:58:43 +0000
Subject: [PATCH 3/5] J25 spike: the cascade keys are read in DevInit

Claude-Session: 96a223bd-8ffd-4e4f-946a-17aeee2548ad
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 proxy/src/cascade.cpp | 9 +++------
 proxy/src/dev.cpp     | 2 +-
 proxy/src/dev.h       | 2 +-
 3 files changed, 5 insertions(+), 8 deletions(-)

diff --git a/proxy/src/cascade.cpp b/proxy/src/cascade.cpp
index 28be359..b0226ea 100644
--- a/proxy/src/cascade.cpp
+++ b/proxy/src/cascade.cpp
@@ -276,13 +276,10 @@ void LoadSwaps() {
 
 } // namespace
 
-void CascadeInit() {
-    const Runtime& rt = Rt();
+void CascadeInit(bool tint, bool count, int split, int size, const std::wstring& dir) {
     InitializeCriticalSection(&s_cs);
-    s_k.tint = rt.cfg.Bool("dev.cascade_tint"); s_k.count = rt.cfg.Bool("dev.cascade_count");
-    if (rt.cfg.Int("dev.cascade_split") > 0) s_k.split = (int)rt.cfg.Int("dev.cascade_split");
-    s_k.size = (int)rt.cfg.Int("dev.cascade_size");
-    s_k.dir = WidenUtf8(rt.cfg.Str("dev.cascade_dir"));
+    s_k.tint = tint; s_k.count = count; s_k.size = size; s_k.dir = dir;
+    if (split > 0) s_k.split = split;
     LOGI("cascade: prototype on: split %d m, size %d (0 = the engine map's), tint %d, count %d", s_k.split, s_k.size, s_k.tint, s_k.count);
     LoadSwaps();
 }
diff --git a/proxy/src/dev.cpp b/proxy/src/dev.cpp
index c9cc3b3..2191f5c 100644
--- a/proxy/src/dev.cpp
+++ b/proxy/src/dev.cpp
@@ -650,7 +650,7 @@ void DevInit() {
     CameraInit(k.camera, Adapter().camera);
     OrdersInit(k.orders, Adapter().orders);
     if (k.capture) CaptureInit();
-    if (k.cascade) CascadeInit();
+    if (k.cascade) CascadeInit(rt.cfg.Bool("dev.cascade_tint"), rt.cfg.Bool("dev.cascade_count"), (int)rt.cfg.Int("dev.cascade_split"), (int)rt.cfg.Int("dev.cascade_size"), WidenUtf8(rt.cfg.Str("dev.cascade_dir")));
 
     std::vector<FileRule> rules;
     if (k.skipIntro) for (const char* const* m = ad->introMovies; m && *m; ++m) rules.push_back(MakeRule(RuleSpace::Movie, RuleAct::Fail, *m, "", "dev.skip_intro"));
diff --git a/proxy/src/dev.h b/proxy/src/dev.h
index 67b65b1..da5fe40 100644
--- a/proxy/src/dev.h
+++ b/proxy/src/dev.h
@@ -65,7 +65,7 @@ std::string OrdersInfo();                             // install state, the owne
 
 // capture.cpp (J8): the frame capture behind dev.capture; decisions in its header
 // cascade.cpp (J25 spike): the two-cascade prototype behind dev.cascade_proto; decisions in its header
-void CascadeInit();                                   // DevInit
+void CascadeInit(bool tint, bool count, int split, int size, const std::wstring& dir);   // DevInit
 void CascadeInstall(void* device);                    // every CreateDevice, before the capture
 void CascadePresent();                                // the render thread, every Present
 void CaptureInit();                                   // DevInit: the capture folder
