+    if (k.cascade) CascadeInit(rt.cfg.Bool("dev.cascade_tint"), rt.cfg.Bool("dev.cascade_count"), (int)rt.cfg.Int("dev.cascade_split"), (int)rt.cfg.Int("dev.cascade_size"), WidenUtf8(rt.cfg.Str("dev.cascade_dir")), rt.cfg.Str("dev.cascade_skip_ps"));
 
     std::vector<FileRule> rules;
     if (k.skipIntro) for (const char* const* m = ad->introMovies; m && *m; ++m) rules.push_back(MakeRule(RuleSpace::Movie, RuleAct::Fail, *m, "", "dev.skip_intro"));
