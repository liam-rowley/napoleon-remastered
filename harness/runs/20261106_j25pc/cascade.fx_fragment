
// J25 prototype: a near cascade sampled beside the engine's map. The world position is already in every sm3 receiver's pixel shader
// (CALC_DISTANCE), so only the pixel shader changes. Registers sit far above any stock use (stock maximum c41, s10).
float4x4 cascade0_matrix : register(c216);   // world -> (u, v, linear z, 1), one row per output component
float4   cascade0_params : register(c220);   // x 1/size, y size, z blend width in uv, w tint (0 off, 1 on)
sampler  cascade0_sampler : register(s15);

float cascade0_taps(float3 c)
{
	float2 o = float2(cascade0_params.x, -cascade0_params.x);
	float4 s;
	s.x = tex2D(cascade0_sampler, c.xy + o.xy).r;
	s.y = tex2D(cascade0_sampler, c.xy).r;
	s.z = tex2D(cascade0_sampler, c.xy + float2(o.x, 0)).r;
	s.w = tex2D(cascade0_sampler, c.xy + float2(0, o.y)).r;
	float4 lit = (c.z < s);
	return pcf_filter(lit, frac(cascade0_params.y * c.xy));
}

float cascade_occlusion(float4 shadow_tex, float3 world_pos, float frame_buffer_depth)
{
	float3 c = mul(float4(world_pos, 1), transpose(cascade0_matrix)).xyz;
	float2 edge = min(c.xy, 1 - c.xy);
	float pick = saturate(min(edge.x, edge.y) / cascade0_params.z);
	float far_map = shadow_map_occlusion(shadow_tex, frame_buffer_depth);
	float near_map = cascade0_taps(c);
	float depth = shadow_map_linear_scale_distance2(frame_buffer_depth);
	near_map = lerp(near_map, 1.0f, pow(depth, shadow_map_far_fade));
	float result = lerp(far_map, near_map, pick);
	return cascade0_params.w > 0.5f ? 1.0f - pick : result;
}
